# Environment variables / secrets
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/

# Generated data
data/raw/*
data/processed/*
data/features/*
data/labels/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep
!data/labels/.gitkeep

# Data file formats
*.parquet
*.feather
*.h5
*.hdf5
*.db
*.sqlite
*.sqlite3

# Optional: stricter CSV protection
*.csv

# Model artifacts and experiment outputs
/models/
/artifacts/
/checkpoints/
/runs/
/reports/
/mlruns/
/wandb/
*.pkl
*.joblib
*.pt
*.pth
*.onnx

# Python cache/build artifacts
/build/
/dist/
__pycache__/
*.py[cod]
*.egg-info/
src/*.egg-info/
